{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "🧩 Debug Frontend + Backend",
      "configurations": ["🟦 Debug API", "🟩 Debug Web"]
    }
  ],
  "configurations": [
    {
      "name": "🟦 Debug API",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      // "protocol": "inspector",
      "cwd": "${workspaceFolder}/apps/api",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/api/dist/**/*.js"]
    },
    {
      "name": "🟩 Debug Web",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "sourceMaps": true,
      "restart": true,
      // "protocol": "inspector",
      "cwd": "${workspaceFolder}/apps/web",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
